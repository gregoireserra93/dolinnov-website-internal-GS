# ============================================
# AIRTABLE — Contacts investisseurs / partenaires
# ============================================
# Personal Access Token : https://airtable.com/create/tokens
# Scopes requis : data.records:read, data.records:write
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_CONTACTS_TABLE=Contacts

# ============================================
# EMAIL — SMTP pour envoyer des messages
# ============================================
# Exemple Gmail (App Password requis : https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gregoire@dolinnov.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="Grégoire Serra <gregoire@dolinnov.com>"

# ============================================
# AUTHENTIFICATION SIMPLE (usage perso)
# ============================================
# Mot de passe pour protéger l'accès au site (à choisir)
APP_PASSWORD=change-moi
# Clé pour signer les sessions (générer : openssl rand -base64 32)
SESSION_SECRET=change-moi-aussi-cle-aleatoire-longue

# ============================================
# OPTIONNEL — APIs pour la veille concurrentielle
# ============================================
# Clé Anthropic pour synthèses automatiques
# ANTHROPIC_API_KEY=sk-ant-xxx
# NewsAPI / autres sources
# NEWS_API_KEY=
