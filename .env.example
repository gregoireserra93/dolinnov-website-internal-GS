# ============================================
# AIRTABLE — Contacts investisseurs / partenaires
# ============================================
# Personal Access Token : https://airtable.com/create/tokens
# Scopes requis : data.records:read, data.records:write
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_CONTACTS_TABLE=Contacts

# ============================================
# EMAIL — Resend (https://resend.com)
# ============================================
# 1. Crée un compte gratuit (3000 emails / mois inclus)
#    https://resend.com/signup
# 2. Génère une API key dans le dashboard → API Keys
# 3. (recommandé) Vérifie le domaine dolinnov.com pour expédier
#    depuis ton adresse pro. Sans domaine vérifié, l'expéditeur DOIT
#    rester "onboarding@resend.dev" (utile pour tester).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# Si domaine non vérifié, laisse "onboarding@resend.dev".
# Une fois le domaine vérifié, remplace par : "Grégoire Serra <gregoire@dolinnov.com>"
RESEND_FROM=onboarding@resend.dev

# ============================================
# AUTHENTIFICATION SIMPLE (usage perso)
# ============================================
# Mot de passe pour protéger l'accès au site (à choisir, peu importe la complexité,
# mais évite "password" ou un mot évident).
APP_PASSWORD=change-moi
# Clé pour signer les cookies de session iron-session.
# Doit faire AU MOINS 32 caractères. Génère-en une avec :
#   openssl rand -base64 32
SESSION_SECRET=change-moi-aussi-cle-aleatoire-d-au-moins-32-caracteres

# ============================================
# OPTIONNEL — APIs pour la veille concurrentielle
# ============================================
# Clé Anthropic pour synthèses automatiques
# ANTHROPIC_API_KEY=sk-ant-xxx
# NewsAPI / autres sources
# NEWS_API_KEY=
